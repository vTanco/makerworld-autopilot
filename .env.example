# API Keys and Secrets for MakerWorld Autopilot
# Copy this file to .env and fill in the values you want to use.

# Optional AI Copywriter (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional AI Text-to-3D providers (Meshy or Tripo3D)
MESHY_API_KEY=
TRIPO_API_KEY=

# Optional Notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Reddit Promotion API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Optional Pinterest API
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
